# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test / lint caches
.pytest_cache/
.ruff_cache/

# Local Claude settings (per-machine permissions)
.claude/

# Local result backups (the canonical run lives in results/tables/)
results/tables_backup_*/

# Logs / scratch
*.log

# CatBoost scratch
catboost_info/

# LaTeX build artefacts.
# The .tex, .pdf and .docx ARE tracked -- they are the deliverables. Everything
# below is regenerated by pdflatex on every run. svjour3.cls / svglov3.clo are
# vendored in paper/springer/ and copied beside the .tex by build_paper.py, so the
# copies at paper/ are artefacts too.
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/svjour3.cls
paper/svglov3.clo
