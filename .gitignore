# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test / lint caches
.pytest_cache/
.ruff_cache/

# Per-machine editor and tool settings. The pattern is deliberately broad: local
# config lives in dot-directories and must never be committed.
.vscode/
.idea/
**/settings.local.json

# Local result backups (the canonical run lives in results/tables/)
results/tables_backup_*/

# Logs / scratch
*.log

# CatBoost scratch
catboost_info/

# Manuscript sources, built PDFs and the reviewer report are kept locally and are
# deliberately not published: the paper is under review. The build tooling
# (build_paper.py, check_paper.py, make_tex.py, make_docx.py) lives under paper/ too,
# so the whole directory is excluded rather than file by file.
paper/
Reviewer2/
HANDOFF.md
# ...and the test that drives the manuscript checker, which lives in paper/.
tests/test_paper_consistency.py
